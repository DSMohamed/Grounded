# ==============================================================================
# GROUNDED — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to '.env' and populate your preferred keys.
# If no LLM keys are supplied, the backend operates in deterministic simulation mode.
# ==============================================================================

# ── 1. PRIMARY LLM: Groq LPU (Ultra-Fast ~400ms Inference) ───────────────────
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── 2. SECONDARY LLM FAILOVER: OpenRouter (Free & Paid Multi-Model) ───────────
# Get a free key at: https://openrouter.ai/keys
OPEN_ROUTER_KEY=your_openrouter_api_key_here
OPEN_ROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── 3. TERTIARY LLM FAILOVER: xAI Grok (Optional) ────────────────────────────
# Get an xAI key at: https://console.x.ai/
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-1212

# ── 4. BACKEND API TARGET (Web Frontend Proxy) ────────────────────────────────
# URL where the frontend talks to FastAPI (default: http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# ── 5. SUPABASE CLOUD DATABASE & AUTH (Optional) ──────────────────────────────
# Used for PostgreSQL conversation sync and user authentication.
# If omitted, the web app operates completely in Guest / LocalStorage mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── 6. NGROK PUBLIC TUNNELING (Mobile & Remote Testing) ──────────────────────
# Free token at: https://dashboard.ngrok.com/get-started/your-authtoken
# Automatically tunnels FastAPI (port 8000) to an HTTPS URL on backend startup.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
