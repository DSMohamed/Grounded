# Groq API - LPU Ultra-fast live generation (Recommended - free & fastest)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API Key - Free or Paid LLM models (2nd priority)
OPEN_ROUTER_KEY=your_openrouter_api_key_here
OPEN_ROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Grok (xAI API) - Ultra-fast live generation (3rd priority / Optional)
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-1212

# Supabase Cloud Database & Auth (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_URL=http://127.0.0.1:8000

# Ngrok Public Tunneling (for Flutter & remote access)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
